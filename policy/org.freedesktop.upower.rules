polkit.addRule(function(action, subject) {
    if (subject.system_unit != "upower.service")
        return polkit.Result.NOT_HANDLED;

    const is_power_action = [
        "power-off",
        "reboot",
        "halt",
        "suspend",
        "hibernate",
    ].some(function (power_action) {
        const base_action = "org.freedesktop.login1." + power_action;
        return action.id == base_action ||
            action.id == base_action + "-multiple-sessions" ||
            action.id == base_action + "-ignore-inhibit";
    });
    if (is_power_action)
        return polkit.Result.YES;
});